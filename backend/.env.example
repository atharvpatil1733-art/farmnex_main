# ============================================================
# FARMNEX API - ENVIRONMENT CONFIGURATION
# ============================================================

# ============================================================
# APPLICATION
# ============================================================

APP_NAME=FarmNex API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

API_V1_PREFIX=/api/v1

# Application host/port
HOST=0.0.0.0
PORT=8000


# ============================================================
# DATABASE - MYSQL
# ============================================================

DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@HOST:6543/postgres

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false


# ============================================================
# REDIS
# ============================================================

REDIS_ENABLED=false
REDIS_URL=

REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5


# ============================================================
# JWT / AUTHENTICATION
# ============================================================

# Recommended asymmetric signing algorithm
JWT_ALGORITHM=RS256

JWT_ISSUER=farmnex-api
JWT_AUDIENCE=farmnex-mobile

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

JWT_PRIVATE_KEY_PATH=secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt_public.pem

# Production (FastAPI Cloud) never receives the git-ignored secrets/ folder, so
# there the keys are given as ONE line of base64 each. When set, these win over
# the *_PATH files. Make them with:  python generate_jwt_keys.py --print-env
# Set them on FastAPI Cloud only, marked secret. Leave empty locally.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=


# ============================================================
# PASSWORD SECURITY
# ============================================================

PASSWORD_HASH_ALGORITHM=argon2id


# ============================================================
# SESSION / REFRESH TOKEN SECURITY
# ============================================================

SESSION_EXPIRE_DAYS=30

REFRESH_TOKEN_ROTATION_ENABLED=true
REFRESH_TOKEN_REUSE_DETECTION_ENABLED=true

MAX_SESSIONS_PER_USER=5


# ============================================================
# CORS
# ============================================================

# Comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

CORS_ALLOW_CREDENTIALS=false


# ============================================================
# SECURITY HEADERS / PROXY
# ============================================================

# Adds X-Content-Type-Options, X-Frame-Options, Referrer-Policy, HSTS, Permissions-Policy
# to every response. Must stay true in production.
ENABLE_SECURITY_HEADERS=true

SECURE_COOKIES=true

TRUST_PROXY_HEADERS=false


# ============================================================
# AUDIT LOGGING
# ============================================================

AUDIT_LOG_ENABLED=true


# ============================================================
# ERROR MONITORING - SENTRY
# ============================================================

SENTRY_ENABLED=false

SENTRY_DSN=

SENTRY_ENVIRONMENT=development

SENTRY_TRACES_SAMPLE_RATE=0.0


# ============================================================
# EMAIL / SMTP
# ============================================================

EMAIL_ENABLED=false

SMTP_HOST=
SMTP_PORT=587

SMTP_USERNAME=
SMTP_PASSWORD=

SMTP_USE_TLS=true

EMAIL_FROM=
EMAIL_FROM_NAME=FarmNex


# ============================================================
# OTP
# ============================================================

# Sign-up and login send a one-time code through MiniMoth (WhatsApp first, SMS
# fallback). Production: OTP_ENABLED=true + MINIMOTH_API_KEY from app.minimoth.dev
# (an account key, set on FastAPI Cloud as a secret). Locally/tests: false.
OTP_ENABLED=false
OTP_PROVIDER=minimoth
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
MINIMOTH_API_BASE_URL=https://api.minimoth.dev
MINIMOTH_API_KEY=
MINIMOTH_TIMEOUT_SECONDS=10


# ============================================================
# SUPABASE PRIVATE FILE STORAGE
# ============================================================

STORAGE_PROVIDER=supabase
STORAGE_BUCKET=storage-bucket
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SUPABASE_SECRET_KEY

# Signed URL lifetime for private files.
STORAGE_SIGNED_URL_EXPIRE_SECONDS=900

# Maximum request accepted by StorageService.
STORAGE_MAX_UPLOAD_SIZE_BYTES=10485760

# Supabase Storage HTTP timeout.
STORAGE_TIMEOUT_SECONDS=15

STORAGE_TEST_ENDPOINTS_ENABLED=false

# ============================================================
# WEATHER SERVICE
# ============================================================

WEATHER_API_ENABLED=false

WEATHER_API_BASE_URL=
WEATHER_API_KEY=

WEATHER_API_TIMEOUT_SECONDS=10


# ============================================================
# AGRICULTURAL MARKET / MANDI SERVICE
# ============================================================

MARKET_API_ENABLED=false

MARKET_API_BASE_URL=
MARKET_API_KEY=

MARKET_API_TIMEOUT_SECONDS=10


# ============================================================
# NOTIFICATION SERVICE
# ============================================================

NOTIFICATION_ENABLED=false

NOTIFICATION_API_BASE_URL=
NOTIFICATION_API_KEY=

NOTIFICATION_API_TIMEOUT_SECONDS=10


# ============================================================
# API DOCUMENTATION
# ============================================================

ENABLE_OPENAPI=true
ENABLE_SWAGGER=true
ENABLE_REDOC=true


# ============================================================
# FEATURE FLAGS
# ============================================================

ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_OTP_LOGIN=false
ENABLE_FILE_UPLOADS=true


# ============================================================
# COMPONENTS (plug-ins). Every flag is OFF by default: with a flag
# off the component is not mounted and the backend starts as before.
# Each component session adds variables ONLY inside its own section.
# Real values are set on FastAPI Cloud, never committed.
# ============================================================

# --- Crop Rescue (spoilage alerts + rescue buyers) ---
ENABLE_CROP_RESCUE=false
# Its own database URL: Supabase SESSION pooler (port 5432),
# postgresql+psycopg://...:5432/postgres?sslmode=require (never the asyncpg DATABASE_URL)
CR_DATABASE_URL=
# Demo-only endpoint that fast-forwards spoilage; off by default, set true only for the demo
CR_ENABLE_SIMULATE=false
# Background spoilage check every 12 h; true on ONE instance only
CR_ENABLE_SCHEDULER=true

# --- AI forecaster connector (price / demand / sell options / crop choice) ---
ENABLE_FORECAST=false
# Address of the separately hosted forecaster service
FORECASTER_URL=
# Server-side key for that service (never sent to the app)
FORECASTER_API_KEY=

# --- Route optimizer (pooled loads, return trips, live tracking) ---
ENABLE_ROUTE_OPTIMIZER=false
# Its own database URL: Supabase SESSION pooler (port 5432),
# postgresql://...:5432/postgres?sslmode=require (never the asyncpg DATABASE_URL; the host also accepts postgres:// and postgresql+psycopg://)
ROUTES_DATABASE_URL=
# Tables come from backend/migrations SQL files, so keep this false
ROUTES_AUTO_CREATE_TABLES=false
# Origin only (no path); used to build live-tracking links
ROUTES_PUBLIC_BASE_URL=https://<YOUR_APP>.fastapicloud.dev
# osrm = real road distances; haversine = straight-line estimates (use if venue internet is bad)
ROUTING_PROVIDER=osrm

# --- Voice tools (endpoints the voice assistant calls; stretch) ---
ENABLE_VOICE_TOOLS=false
